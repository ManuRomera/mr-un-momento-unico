<div class="umu-safety-panel">
  <p class="umu-lede">{{localize "UMU.Safety.Intro"}}</p>
  <button type="button" class="umu-safety-btn pause" data-action="signal" data-signal="pause"><i class="fa-solid fa-pause" aria-hidden="true"></i><span><strong>{{localize "UMU.Safety.Pause"}}</strong><small>{{localize "UMU.Safety.PauseHint"}}</small></span></button>
  <button type="button" class="umu-safety-btn veil" data-action="signal" data-signal="veil"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i><span><strong>{{localize "UMU.Safety.Veil"}}</strong><small>{{localize "UMU.Safety.VeilHint"}}</small></span></button>
  <button type="button" class="umu-safety-btn x" data-action="signal" data-signal="x"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span><strong>{{localize "UMU.Safety.X"}}</strong><small>{{localize "UMU.Safety.XHint"}}</small></span></button>
  <p class="umu-note"><i class="fa-solid fa-user-secret" aria-hidden="true"></i>{{localize "UMU.Safety.Anonymous"}}</p>
  <p class="umu-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i>{{localize "UMU.Safety.Topics"}}</p>
</div>
