<div class="umu-welcome">
  <img class="umu-welcome-art" src="{{cover}}" alt="">
  <p><strong>{{localize "UMU.Welcome.Ready"}}</strong> {{localize "UMU.Welcome.Body"}}</p>
  <div class="umu-welcome-grid">
    <button type="button" class="umu-primary" data-action="go" data-app="table"><i class="fa-solid fa-torii-gate" aria-hidden="true"></i>{{localize "UMU.Welcome.Table"}}</button>
    <button type="button" data-action="go" data-app="safety"><i class="fa-solid fa-shield-heart" aria-hidden="true"></i>{{localize "UMU.Welcome.Safety"}}</button>
    <button type="button" data-action="go" data-app="access"><i class="fa-solid fa-universal-access" aria-hidden="true"></i>{{localize "UMU.Access.Title"}}</button>
  </div>
  <button type="button" class="umu-link" data-action="hide">{{localize "UMU.Welcome.Hide"}}</button>
</div>
