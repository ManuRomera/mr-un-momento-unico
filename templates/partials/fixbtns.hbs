<span class="umu-fix-btns">
  <button type="button" class="umu-fix-btn" data-action="fixLedger" data-seat="{{seat}}" data-kind="{{kind}}" data-delta="-1" aria-label="{{localize 'UMU.Fix.LessOf' what=label name=name}}" data-tooltip="{{localize 'UMU.Fix.LessOf' what=label name=name}}"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
  <button type="button" class="umu-fix-btn" data-action="fixLedger" data-seat="{{seat}}" data-kind="{{kind}}" data-delta="1" aria-label="{{localize 'UMU.Fix.MoreOf' what=label name=name}}" data-tooltip="{{localize 'UMU.Fix.MoreOf' what=label name=name}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
</span>
